    "test:channel-extras": "node tests/channel-extras.mjs",
    "test:codely": "node tests/codely-channel.mjs",
    "test:autoclaw": "node tests/autoclaw-channel.mjs",
    "test:own-inference": "node tests/own-inference.mjs",
    "test:accio": "node tests/accio-channel.mjs",
    "test:minimax": "node tests/minimax-channel.mjs",
    "test:marvis": "node tests/marvis-channel.mjs",
    "test:magicrew": "node tests/magicrew-channel.mjs",
    "test:monkeycode": "node tests/monkeycode-channel.mjs",
    "test:chromium": "node tests/chromium-driver.mjs",
    "test:drift": "node scripts/check-install-drift.mjs",
    "test:pack": "node tests/channel-pack-tables.mjs",
    "test:visibility": "node tests/channel-visibility.mjs",
    "test": "node scripts/test-all.mjs",
